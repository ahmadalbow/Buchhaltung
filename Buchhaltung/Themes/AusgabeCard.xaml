<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TextBoxTheme.xaml"></ResourceDictionary>
        <ResourceDictionary Source="ButtonTheme.xaml"></ResourceDictionary>
        <ResourceDictionary Source="CloseButtonTheme.xaml"></ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="ListViewItem" x:Key="AusgabeCard">
        <Style.Setters>
            <Setter Property="Template" >
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">

                        <Border VerticalAlignment="Center" Height="45" Background="White" CornerRadius="5" Margin="0 5 0 0" >
                            <Grid>
                                <Grid  VerticalAlignment="Center"  >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition/>

                                        <ColumnDefinition Width="35"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Margin="20 0 10 0" Content="{Binding Number}" FontSize="16" FontWeight="Medium"></Label>
                                    <Label Grid.Column="1" Margin="20 0 10 0" Content="{Binding Date}" FontSize="16" FontWeight="Medium"/>
                                    <Label Grid.Column="2"  Margin="20 0 10 0" Content="{Binding Betrag}" FontSize="16" FontWeight="Medium"/>
                                    <Label Grid.Column="3"  Margin="20 0 10 0" Content="{Binding details}" FontSize="16" FontWeight="Medium"/>
                                    <Button Command="{Binding RemoveAusgabe}"
                                        Margin="10" Grid.Column="4">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Style.Setters>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Setter Property="Background" Value="white"/>
                                                    <Setter Property="Content" Value="🞪"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Height="20"
                                Width="20"
                                >
                                                                    <Label Content="{TemplateBinding Content}" 
                                   FontSize="15"
                                   Margin="-1.5 -5 0 0 "
                                   
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   >
                                                                    </Label>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style.Setters>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF2E2E"/>
                                                        <Setter Property="Foreground" Value="White"/>

                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Opacity" Value="0.7" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <!--<Grid  VerticalAlignment="Center" Background="White"  >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="35"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource TextBoxTheme}" Height="30" Grid.Column="0" Margin="20 0 10 0" Text="{Binding Number}" FontSize="16" FontWeight="Medium"></TextBox>
                                    <TextBox Style="{StaticResource TextBoxTheme}" Height="30" Grid.Column="1" Margin="20 0 10 0" Text="{Binding Date}" FontSize="16" FontWeight="Medium"/>
                                    <TextBox Style="{StaticResource TextBoxTheme}" Height="30" Grid.Column="2"  Margin="20 0 10 0" Text="{Binding Betrag}" FontSize="16" FontWeight="Medium"/>
                                    <TextBox Style="{StaticResource TextBoxTheme}" Height="30" Grid.Column="3"  Margin="20 0 10 0" Text="{Binding details}" FontSize="16" FontWeight="Medium"/>
                                    <Button Background="#097969"
                                            Foreground="White"
                                            Style="{StaticResource CloseButtonTheme}"                                           
                                            Grid.Column="4"
                                            Height="30"
                                            Width="30"
                                            Content="✓">
                                    </Button>
                                    <Button Background="#FF2E2E"
                                            Style="{StaticResource CloseButtonTheme}"                                           
                                            Grid.Column="5"
                                            Height="30"
                                            Width="30"
                                            Content="🞪"
                                            Foreground="White">
                                    </Button>

                                </Grid>-->
                            </Grid>


                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

</ResourceDictionary>