<Window x:Class="Buchhaltung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buchhaltung" xmlns:viewmodell="clr-namespace:Buchhaltung.MVVM.ViewModell"
        xmlns:local1="clr-namespace:Buchhaltung.Core"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Height="850" Width="1180"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="Buchhaltung" 
        WindowStartupLocation="CenterScreen"
        Background="Transparent" Icon="/1802749.ico">
    <Window.DataContext>
        <viewmodell:MainViewModell/>
    </Window.DataContext>
    <Window.Resources>
        <local1:PercentageConverter x:Key="PercentageConverter"/>
    </Window.Resources>
    <Border CornerRadius="15" 
            MouseDown="Drag"  
            Background="#EFF3F2"
            BorderBrush="#aaa"
            BorderThickness="1">
            
        <Grid VerticalAlignment="Stretch" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition  Height="40" />
                <RowDefinition   />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Label FontWeight="SemiBold" 
                       Content="Buchhaltung"
                       Margin="15 4"
                       FontSize="16"/>

                <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment ="Right"
                        VerticalAlignment="Center">
                    <Button  Margin="0 0 10 0"
                         Content="🞪" 
                             Height="35"
                         Style="{StaticResource CloseButtonTheme}" Click="Button_Click"
                         >
                    </Button>
                </StackPanel>
            </Grid>
            <Grid VerticalAlignment="Stretch" Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Margin="20 0"
                    x:Name="canvas" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0"
                   Margin="0 10 0 0"
                   Content="Reservations Files" 
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" />
                <ListView Grid.Row="1"
                          MaxWidth="700"
                          HorizontalAlignment="Stretch"
                          MinHeight="20"
                          Background="Transparent"
                      BorderThickness="0" 
                      ItemsSource="{Binding paths}"
                      ItemContainerStyle="{StaticResource ReservationCard}"
                      Margin="0 5">
                </ListView>
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button  Background="#003B95"
                    Style="{StaticResource ButtonTheme}"
                    Content="Add  Booking"
                     Command="{Binding addFromBookingCommand}"
                             Height="40"
                             Margin="10">
                    </Button>
                    <Button Background="#FF385C"
                    Style="{StaticResource ButtonTheme}"
                    Content="Add  Airbnb"
                        Command="{Binding addFromAirbnbCommand}"
                            Height="40"
                            Margin="10">
                    </Button>
                    
                </StackPanel>
            </Grid>
            <Grid VerticalAlignment="Stretch" Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Margin="20 0"
                    x:Name="canvas1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0"
                   Margin="0 10 0 0"
                   Content="Ausgaben" 
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" />
                <ListView Grid.Row="1"
                          MaxWidth="700"
                          HorizontalAlignment="Stretch"
                          MinHeight="20"
                          Background="Transparent"
                      BorderThickness="0" 
                      ItemsSource="{Binding Ausgaben}"
                      ItemContainerStyle="{StaticResource AusgabeCard}"
                      Margin="0 5">
                </ListView>
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Background="#555"  Height="40"
                    Style="{StaticResource ButtonTheme}"
                    Content="Add "
                        Command="{Binding addAusgaben}"
                        Margin="10">
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">

                <WrapPanel HorizontalAlignment="Center">
                    <Button Background="#555" Height="40" Margin="10"
                    Style="{StaticResource ButtonTheme}"
                    Content="Export .bow File "
                        Command="{Binding ExportFileCommand}" >
                    </Button>
                    <Button Background="#555" Height="40" Margin="10"
                    Style="{StaticResource ButtonTheme}"
                    Content="Import .bow File "
                        Command="{Binding ImportFileCommand}" >
                    </Button>
                    <Button Background="#1D6F42"
                    Style="{StaticResource ButtonTheme}"
                    Content="Create Buchhaltung"
                    Command="{Binding CreateBuchHaltungCommand}"
                        Height="40"
                        Margin="10">
                    </Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
